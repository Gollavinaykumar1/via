# .env.example — Copy to .env and fill real values

MODEL_NAME=llama3.2:latest
OLLAMA_URL=http://localhost:11434/api/generate
REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=2

# Optional: Use Groq cloud instead of Ollama
USE_GROQ=false
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_digital_team
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=your_strong_password

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_URL=redis://localhost:6379/1

JWT_SECRET_KEY=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

RATE_LIMIT_PER_MINUTE=20

APP_ENV=development
APP_VERSION=6.0.0
MEMORY_INJECTION_COUNT=3
COMPLEX_TASK_THRESHOLD=80

GITHUB_TOKEN=your-github-personal-access-token
GITHUB_USERNAME=your-github-username
RENDER_API_KEY=your-render-api-key
